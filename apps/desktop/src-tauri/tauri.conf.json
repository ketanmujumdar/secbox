{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "secbox",
  "mainBinaryName": "secbox-desktop",
  "version": "0.1.0",
  "identifier": "dev.secbox.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "secbox",
        "width": 1120,
        "height": 760,
        "minWidth": 880,
        "minHeight": 600,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "appimage"],
    "category": "DeveloperTool",
    "shortDescription": "Run a project inside a disposable microVM",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/secbox",
      "binaries/secboxd"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
