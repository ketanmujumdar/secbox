{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window may call the app's own daemon commands and nothing else. No file system, shell, HTTP or opener plugin is installed or granted, and no core permission is granted.",
  "windows": ["main"],
  "permissions": [
    "allow-app-info",
    "allow-daemon-state",
    "allow-start-daemon",
    "allow-list-projects",
    "allow-add-project",
    "allow-status",
    "allow-plan",
    "allow-up",
    "allow-down",
    "allow-destroy",
    "allow-logs",
    "allow-logs-stop",
    "allow-blocked",
    "allow-import-remote",
    "allow-git",
    "allow-diff"
  ]
}
