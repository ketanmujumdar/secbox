{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window may call the app's own daemon commands and nothing else. set-secret is write-only: the daemon stores the value, and no command reads one back. No file system, shell, HTTP or opener plugin is installed or granted, and no core permission is granted.",
  "windows": ["main"],
  "permissions": [
    "allow-app-info",
    "allow-daemon-state",
    "allow-start-daemon",
    "allow-list-projects",
    "allow-add-project",
    "allow-status",
    "allow-plan",
    "allow-up",
    "allow-down",
    "allow-destroy",
    "allow-logs",
    "allow-logs-stop",
    "allow-blocked",
    "allow-import-remote",
    "allow-git",
    "allow-diff",
    "allow-remove-project",
    "allow-approve-host",
    "allow-allowed-hosts",
    "allow-block-host",
    "allow-secrets",
    "allow-set-secret",
    "allow-secret-files",
    "allow-read-secret-file",
    "allow-use-secret-file",
    "allow-connect-agent",
    "allow-open-in-vscode",
    "allow-problems",
    "allow-resource-choices",
    "allow-set-resources",
    "allow-port-choices",
    "allow-set-port"
  ]
}
